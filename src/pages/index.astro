---
import Layout from "../layouts/Layout.astro";
import type { PokemonListResponse } from "../interfaces/pokemon-list.interface.ts";
import PokemoCard from "../components/pokemons/PokemoCard.astro";

const resp = await fetch("https://pokeapi.co/api/v2/pokemon").then(
	(res) => res,
);

const data = (await resp.json()) as PokemonListResponse;
---

<Layout title="home">
	<h1 class="text-3xl">Listado de pokemons</h1>
  <hr>
	<section
    aria-label="Listado de pokemons"
    class="grid grid-cols-1 sm:grid-cols-4 md:grid-cols-5 gap-4 mt-5"
  >
		{data.results.map((pokemon) => <PokemoCard name={pokemon.name} url={pokemon.url} />)}
  </section>
</Layout>
