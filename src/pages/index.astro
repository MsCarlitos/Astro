---
import MainLayout from "../layouts/MainLayout.astro";

const name: string = "Carlos Alberto Mendoza Contreras";
const title: string = "Home Page";
---

<MainLayout title={title}>
  <h1>{name}</h1>

  <p>Momento Actual: {new Date().toLocaleTimeString()}</p>
  <p id="current-time"></p>

  <!-- <footer>Año: 2023</footer> -->

  <script>
    const currentYear: number = new Date().getFullYear();
    const currentTimeParagraph: string = new Date().toLocaleTimeString();

    const footer = document.querySelector("footer") as HTMLElement;
    const currentTime = document.getElementById("current-time") as HTMLElement;

    footer.innerText = `Año: ${currentYear}`;
    currentTime.innerHTML = `Current Time: ${currentTimeParagraph}`;
  </script>
</MainLayout>
