---
import type { GetStaticPaths } from "astro";
import Layout from "../../layouts/Layout.astro";
import PokemoCard from "../../components/pokemons/PokemoCard.astro";
import type { PokemonListResponse } from "../../interfaces/pokemon-list.interface";

export const getStaticPaths = (async () => {
  const resp = await fetch('https://pokeapi.co/api/v2/pokemon?limit=151');
  const { results } = (await resp.json()) as PokemonListResponse;

  return results.map(({ name, url }) => ({
    params: { name: name },
      props: { name: name, url: url },
  }))
  // return [
  //   {
  //     params: { name: "bulbasaur" },
  //     props: { name: "bulbasaur", url: "https://pokeapi.co/api/v2/pokemon/1/" },
  //   },
  //   {
  //     params: { name: "charmander" },
  //     props: { name: "bulbasaur", url: "https://pokeapi.co/api/v2/pokemon/4/" },
  //   },
  // ];
}) satisfies GetStaticPaths;

const { name } = Astro.params;
const { url } = Astro.props;

const id = url.split('/').at(-2);
const imageSrc = `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/other/official-artwork/${id}.png`;

const audioSrcLegacy = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/legacy/${id}.ogg`;
const audioSrcLatest = `https://raw.githubusercontent.com/PokeAPI/cries/main/cries/pokemon/latest/${id}.ogg`;
---

<Layout title={`Pokemon -# ${id} ${name}`} description={`Informaación sobre el pokemon ${name}`} image={imageSrc} >
  <section class="mt-10 mx-10 flex flex-col justify-center items-center">
    <div>
      <a href="/">Regresar</a>
      <h1 class="text-3xl capitalize">{name}</h1>
    </div>
    <PokemoCard name={name} url={url} isBig />

    <span>Audio Legacy</span>
    <audio controls class="m-2">
      <source src={audioSrcLegacy} type="audio/ogg"/>
    </audio>
    <br>
    <span>Audio Latest</span>
    <audio controls class="m-2">
      <source src={audioSrcLatest} type="audio/ogg"/>
    </audio>
  </section>
</Layout>
