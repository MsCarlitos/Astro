---
import '../styles/global.css';

import Navbar from "../components/Navbar.astro";
import { ClientRouter } from 'astro:transitions';
interface Props {
	title: string;
	age?: number;
	isActive?: boolean;
}
const { title, age, isActive } = Astro.props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<Navbar />
		<slot />
	</body>
</html>
